# AWS region where portal-created Bedrock AgentCore agents are deployed.
# Must have Bedrock model access enabled for whatever model you select.
#
# Prefer AGENTCORE_REGION. AWS_REGION is honoured as a fallback, but it's a
# standard SDK variable that other tools on your machine may already export for
# their own purposes -- and an export beats .env (python-dotenv's
# override=False), so a stray one silently retargets your deploys. Regional
# resources below (staging bucket, ECR repository, web search Gateway) must all
# live in whichever region this resolves to.
AGENTCORE_REGION=us-east-1
AWS_REGION=us-east-1

# One shared IAM role every portal-created AWS agent's AgentCore Runtime
# assumes (invoke-model + write-logs only -- see README for the exact
# trust/permissions policy and the one-time setup commands).
AGENTCORE_EXECUTION_ROLE_ARN=arn:aws:iam::your-account-id:role/agent-portal-agentcore-execution

# S3 bucket CreateAgentRuntime stages each agent's deployment zip through.
# Create one with: aws s3api create-bucket --bucket <bucket-name> --region <region>
AGENTCORE_STAGING_BUCKET=your-bucket-name

# Optional: extra regions the New Agent form offers as deploy targets, on top of
# AGENTCORE_REGION above (which is always offered, and stays the default).
# Comma-separated. Leave unset to keep the portal single-region.
#
# Each extra region needs its own one-time setup, because the resources a deploy
# touches are regional: a staging bucket (below), an ECR repository if you'll
# deploy container-mode agents there (AGENTCORE_REGION=<region>
# ./scripts/setup_aws_container.sh), and CloudWatch Transaction Search if you
# want traces. Existing agents are unaffected -- the portal reads each agent's
# region off its own ARN, so chat/delete/trace/load test follow an agent
# wherever it lives.
#AGENTCORE_REGIONS=us-west-2,eu-central-1

# Required for every region in AGENTCORE_REGIONS other than the default one:
# AgentCore reads the code zip with a client bound to the runtime's own region,
# so a bucket elsewhere fails the create with "S3 operation failed: Moved
# Permanently (Status Code: 301)". The portal checks the pairing before it
# builds anything and names the variable to set. One variable per region, the
# region spelled with underscores:
#   aws s3api create-bucket --bucket <bucket-name> --region us-west-2 \
#     --create-bucket-configuration LocationConstraint=us-west-2
#AGENTCORE_STAGING_BUCKET_US_WEST_2=your-us-west-2-bucket-name

# Optional, container-mode deploys only (the "Container image (ECR)" choice in
# the New Agent form; code zip is the default and needs none of this). Both
# have working defaults, so you normally leave them commented out -- but
# container mode does need one-time AWS setup first, which is a script:
#   ./scripts/setup_aws_container.sh
# It creates the ECR repository and grants the execution role above permission
# to pull from it. Skipping the second half is the failure worth avoiding: the
# deploy builds and pushes fine, then the runtime lands in CREATE_FAILED. See
# docs/aws.md's "Container deploys". Deploying also needs Docker running.
#AGENTCORE_ECR_REPOSITORY=agent-portal-agents
#AGENTCORE_CONTAINER_BUILDER=docker

# Optional: override the AgentCore endpoint instead of the default one botocore
# resolves. Leave unset for normal use.
#
# Per-region (suffix matches AGENTCORE_STAGING_BUCKET_US_WEST_2 convention):
#   AGENTCORE_CONTROL_ENDPOINT_URL_US_EAST_1=https://...
#   AGENTCORE_DATA_ENDPOINT_URL_US_EAST_1=https://...
# Or unsuffixed to apply to every region:
#   AGENTCORE_CONTROL_ENDPOINT_URL=https://...
#   AGENTCORE_DATA_ENDPOINT_URL=https://...
#
# Control and data planes are separate variables because an endpoint is often
# offered for only one of them: overriding control alone redirects
# create/list/delete while chat and load-test keep talking to the normal data
# plane.
#
# Note these are the portal's own settings, deliberately not the ambient
# AWS_ENDPOINT_URL_BEDROCK_AGENTCORE[_CONTROL] variables that botocore also
# honors. Those redirect every tool sharing the shell, including the AWS CLI you
# would use to check what the portal just did.

# URL of the deployed FRED (economic data) remote MCP server -- see
# deploy_fred_mcp.sh and README's "MCP servers" section. Available to any
# agent on any platform that selects it in the create-agent form.
FRED_MCP_SERVER_URL=https://your-fred-mcp-service.a.run.app/mcp

# Optional: MCP endpoint (gatewayUrl) of an AgentCore Gateway with the
# managed Web Search Tool connector attached -- see docs/aws.md's "AWS web search
# via AgentCore Gateway" section for the one-time setup. Only needed if
# you'll deploy AWS agents with the "Web search (AWS AgentCore Gateway)"
# tool selected; leave unset otherwise.
AGENTCORE_WEB_SEARCH_GATEWAY_URL=https://gateway-xxxxxxxxxx.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Optional: skip startup discovery of agents this portal didn't create.
# The portal otherwise imports every deployed agent it finds in the
# configured account/project (see README's "Seeding existing agents"),
# which is unhelpful on an account with a lot of unrelated agents --
# imported rows often can't be chatted with, and their Delete button acts
# on another project's resource. Unset/false keeps the default behavior.
AGENT_PORTAL_NO_SEED=false
